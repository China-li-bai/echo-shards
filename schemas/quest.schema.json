{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echo-shards.local/schemas/quest.schema.json",
  "title": "EchoShards Text Quest",
  "description": "回声交易所文字信息差任务。必须含 student_knows / npc_knows / must_elicit。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "goal",
    "roles",
    "student_knows",
    "npc_knows",
    "must_elicit",
    "success_criteria",
    "rubric"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "goal": { "type": "string", "minLength": 1 },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["student", "npc"],
      "properties": {
        "student": { "type": "string", "minLength": 1 },
        "npc": { "type": "string", "minLength": 1 }
      }
    },
    "student_knows": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "npc_knows": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "must_elicit": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "target_lexemes": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "max_turns": { "type": "integer", "minimum": 1, "default": 12 },
    "rubric": { "type": "string", "minLength": 1 },
    "modality": { "type": "string", "const": "text", "default": "text" }
  }
}
