{
  "name": "@echo-shards/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 43123",
    "build": "NEXT_DIST_DIR=\"${NEXT_DIST_DIR:-.next-build}\" next build",
    "start": "next start -H 0.0.0.0 -p 43123",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "preview": "NEXT_DIST_DIR=.next opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "NEXT_DIST_DIR=.next opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "NEXT_DIST_DIR=.next opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "build:worker": "NEXT_DIST_DIR=.next opennextjs-cloudflare build"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@echo-shards/core": "0.1.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@opennextjs/cloudflare": "^1.20.13",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.152.0"
  }
}
