{
  "name": "echo-shards",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "言灵残片 Echo Shards — text-first FSRS / TOPRA / info-gap quests",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "npm run dev -w @echo-shards/web",
    "demo": "npm run demo -w @echo-shards/core",
    "demo:quest": "npm run demo:quest -w @echo-shards/core",
    "demo:policy": "npm run demo:policy -w @echo-shards/core",
    "test": "npm run demo && npm run demo:quest && npm run demo:policy",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint -w @echo-shards/web",
    "import:ngsl-s": "tsx scripts/import-ngsl-s.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
