{
  "name": "echo-shards",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "言灵残片 Echo Shards — text-first FSRS / TOPRA / info-gap quests",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @echo-shards/web",
    "demo": "npm run demo -w @echo-shards/core",
    "demo:quest": "npm run demo:quest -w @echo-shards/core",
    "demo:policy": "npm run demo:policy -w @echo-shards/core",
    "test": "npm run demo && npm run demo:quest && npm run demo:policy && npm run demo:day && npm run demo:eval",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint -w @echo-shards/web",
    "import:ngsl-s": "tsx scripts/import-ngsl-s.ts",
    "demo:day": "npm run demo:day -w @echo-shards/core",
    "demo:eval": "npm run demo:eval -w @echo-shards/core",
    "enrichment:validate": "tsx scripts/enrichment-validate.ts",
    "enrichment:queue": "tsx scripts/enrichment-queue.ts",
    "enrichment:merge": "tsx scripts/enrichment-merge.ts",
    "build": "npm run build -w @echo-shards/web",
    "check": "npm test && npm run assert && npm run typecheck && npm run build && npm run enrichment:validate",
    "preview": "npm run preview -w @echo-shards/web",
    "deploy": "npm run deploy -w @echo-shards/web",
    "build:worker": "npm run build:worker -w @echo-shards/web",
    "demo:restore": "npm run demo:restore -w @echo-shards/core",
    "assert:camp": "node --import tsx scripts/assert-camp-progress-local.mjs",
    "assert:shard-wall": "node --import tsx scripts/assert-shard-wall.mjs",
    "assert:word-tide": "node --import tsx scripts/assert-word-tide-gate.mjs",
    "assert:pr1-cta": "node --import tsx scripts/assert-pr1-practice-cta.mjs",
    "assert:pr2-empty-wall": "node --import tsx scripts/assert-pr2-empty-wall.mjs",
    "assert:pr3-lock-rest": "node --import tsx scripts/assert-pr3-lock-rest.mjs",
    "assert:pr4-learner-noise": "node --import tsx scripts/assert-pr4-learner-noise.mjs",
    "assert:pr5-lesson-first": "node --import tsx scripts/assert-pr5-lesson-first-shell.mjs",
    "assert:pr6-look-once": "node --import tsx scripts/assert-pr6-look-once.mjs",
    "assert": "npm run assert:camp && npm run assert:shard-wall && npm run assert:word-tide && npm run assert:pr1-cta && npm run assert:pr2-empty-wall && npm run assert:pr3-lock-rest && npm run assert:pr4-learner-noise && npm run assert:pr5-lesson-first && npm run assert:pr6-look-once && npm run assert:pr7-first-day-nav && npm run assert:pr8-clear-practice && npm run assert:e1-ci && npm run assert:e2a && npm run assert:e2b && npm run assert:e2c && npm run assert:e3a && npm run assert:e3b && npm run assert:e5a && npm run assert:e7a",
    "assert:pr7-first-day-nav": "node --import tsx scripts/assert-pr7-first-day-nav.mjs",
    "assert:pr8-clear-practice": "node --import tsx scripts/assert-pr8-clear-practice.mjs",
    "assert:e1-ci": "node scripts/assert-e1-ci-workflow.mjs",
    "assert:e2a": "node --import tsx scripts/assert-e2a-rate-idempotent.mjs",
    "assert:e2b": "node --import tsx scripts/assert-e2b-grade-once.mjs",
    "assert:e2c": "node --import tsx scripts/assert-e2c-round-compat.mjs",
    "assert:e3a": "node --import tsx scripts/assert-e3a-meaning-use.mjs",
    "assert:e3b": "node --import tsx scripts/assert-e3b-meaning-use-step.mjs",
    "assert:e5a": "node --import tsx scripts/assert-e5a-fixture-model.mjs",
    "assert:e7a": "node --import tsx scripts/assert-e7a-learning-evidence.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
